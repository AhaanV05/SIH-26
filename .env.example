# PostgreSQL connection used by Prisma. This is a placeholder, not a real credential.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mahasetu?schema=public"

# Keep fixture mode enabled unless an authorized integration has been configured.
MAHASETU_INTEGRATION_MODE="OFFLINE_FIXTURE"

# Optional AI provider configuration. Never commit an actual key.
AI_PROVIDER_API_KEY=""
AI_PROVIDER_MODEL=""
