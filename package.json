  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "^19.2.0",
    "eslint": "10.9.1",
    "eslint-config-next": "16.3.3",
    "prisma": "6.19.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
